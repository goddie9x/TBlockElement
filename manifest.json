{
    "name": "TBlock",
    "description": "__MSG_appDescription__",
    "version": "1.0.7",
    "default_locale": "vi",
    "icons": {
        "16": "assets/image/icon-16.png",
        "32": "assets/image/icon-32.png",
        "48": "assets/image/icon-48.png",
        "192": "assets/image/icon-192.png"
    },
    "action": {
        "default_popup": "src/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "assets/js/content/inject-main.js"
            ],
            "world": "MAIN",
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "assets/js/content/state.js",
                "assets/js/content/utils.js",
                "assets/js/content/unblock.js",
                "assets/js/content/youtube-ads.js",
                "assets/js/content/youtube-channels.js",
                "assets/js/content/ads.js",
                "assets/js/content/annoyances.js",
                "assets/js/content/picker.js",
                "assets/js/content/main.js"
            ],
            "css": [
                "assets/css/all.min.css",
                "assets/css/common.css",
                "assets/css/content.css"
            ],
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "options_page": "src/options.html",
    "commands": {
        "quick-select": {
            "suggested_key": {
                "default": "Alt+Shift+B"
            },
            "description": "__MSG_commandQuickSelect__"
        },
        "start-select": {
            "suggested_key": {
                "default": "Alt+Shift+E"
            },
            "description": "__MSG_commandStartSelect__"
        }
    },
    "permissions": [
        "tabs",
        "storage",
        "contextMenus",
        "unlimitedStorage",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "webNavigation",
        "alarms",
        "identity"
    ],
    "oauth2": {
        "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file"
        ]
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "assets/block/hostRuleYtb.json"
            },
            {
                "id": "ruleset_2",
                "enabled": true,
                "path": "assets/block/hostRules.json"
            },
            {
                "id": "ruleset_3a",
                "enabled": true,
                "path": "assets/block/jerryn70HostsRulesYT-1.json"
            },
            {
                "id": "ruleset_3b",
                "enabled": true,
                "path": "assets/block/jerryn70HostsRulesYT-2.json"
            },
            {
                "id": "ruleset_3c",
                "enabled": true,
                "path": "assets/block/jerryn70HostsRulesYT-3.json"
            },
            {
                "id": "ruleset_3d",
                "enabled": true,
                "path": "assets/block/jerryn70HostsRulesYT-4.json"
            },
            {
                "id": "ruleset_4",
                "enabled": true,
                "path": "assets/block/HostsRulesFb.json"
            }
        ]
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/webfonts/fa-brands-400.ttf",
                "assets/webfonts/fa-brands-400.woff",
                "assets/webfonts/fa-brands-400.woff2",
                "assets/webfonts/fa-duotone-900.ttf",
                "assets/webfonts/fa-duotone-900.woff",
                "assets/webfonts/fa-duotone-900.woff2",
                "assets/webfonts/fa-light-300.ttf",
                "assets/webfonts/fa-light-300.woff",
                "assets/webfonts/fa-light-300.woff2",
                "assets/webfonts/fa-regular-400.ttf",
                "assets/webfonts/fa-regular-400.woff",
                "assets/webfonts/fa-regular-400.woff2",
                "assets/webfonts/fa-solid-900.ttf",
                "assets/webfonts/fa-solid-900.woff",
                "assets/webfonts/fa-solid-900.woff2",
                "assets/webfonts/fa-thin-100.ttf",
                "assets/webfonts/fa-thin-100.woff",
                "assets/webfonts/fa-thin-100.woff2"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "background": {
        "service_worker": "assets/js/background/main.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "manifest_version": 3
}
